+struct wlr_output_mode *
+pickmonmode(struct wlr_output *wlr_output, const MonitorRule *r)
+{
+	struct wlr_output_mode *mode, *best = NULL;
+	int target_mhz, best_diff = 0, diff;
+
+	if (!r) {
+		for (r = monrules; r < END(monrules); r++) {
+			if (!r->name || strstr(wlr_output->name, r->name))
+				break;
+		}
+		if (r >= END(monrules))
+			r = NULL;
+	}
+
+	if (r && r->resx > 0 && r->resy > 0) {
+		target_mhz = r->refresh > 0.0f ? (int)(r->refresh * 1000.0f + 0.5f) : 0;
+		wl_list_for_each(mode, &wlr_output->modes, link) {
+			if (mode->width != r->resx || mode->height != r->resy)
+				continue;
+			if (target_mhz <= 0) {
+				if (!best || mode->preferred || mode->refresh > best->refresh)
+					best = mode;
+			} else {
+				diff = mode->refresh - target_mhz;
+				if (diff < 0)
+					diff = -diff;
+				if (!best || diff < best_diff) {
+					best = mode;
+					best_diff = diff;
+				}
+			}
+		}
+	}
+
+	return best ? best : wlr_output_preferred_mode(wlr_output);
+}
