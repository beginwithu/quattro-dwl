#!/bin/bash

# quattro:summary=Get or set the active dwl layout (dwindle, floating, tile, monocle)
# quattro:group=dwl
# quattro:name=workspace layout default
# quattro:args=[dwindle|floating|tile|monocle]

set -euo pipefail

STATE_FILE="$HOME/.local/state/quattro/toggles/dwl/layout-default"

if [[ -z ${1:-} ]]; then
  if [[ -r $STATE_FILE ]]; then
    cat "$STATE_FILE"
    exit 0
  fi
  if command -v quattro-dwl-ipc >/dev/null 2>&1; then
    idx=$(quattro-dwl-ipc --once 2>/dev/null | jq -r '[.outputs[] | select(.active == true)][0].layoutIndex // 0' 2>/dev/null || echo 0)
    case $idx in
      1) echo floating ;;
      2) echo tile ;;
      3) echo monocle ;;
      *) echo dwindle ;;
    esac
  else
    echo dwindle
  fi
  exit 0
fi

case $1 in
  dwindle)  idx=0 ;;
  floating) idx=1 ;;
  tile)     idx=2 ;;
  monocle)  idx=3 ;;
  *)
    echo "Usage: quattro-dwl-workspace-layout-default [dwindle|floating|tile|monocle]" >&2
    exit 1
    ;;
esac

mkdir -p "${STATE_FILE%/*}"
printf '%s\n' "$1" >"$STATE_FILE"
if command -v quattro-dwl-ipc >/dev/null 2>&1; then
  quattro-dwl-ipc set-layout focused "$idx" >/dev/null 2>&1 || true
fi
