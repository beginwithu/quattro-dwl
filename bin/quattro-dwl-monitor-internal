#!/bin/bash

# quattro:summary=Enable, disable, or toggle the built-in laptop display
# quattro:group=dwl
# quattro:name=monitor internal
# quattro:args=[on|off|toggle]

set -euo pipefail

INTERNAL=$(quattro-dwl-ipc --monitors 2>/dev/null | jq -r '[.[] | select(.name | test("^(eDP|LVDS|DSI)-"))][0].name // empty')
[[ -n $INTERNAL ]] || { echo "No built-in display found" >&2; exit 1; }

ACTION=${1:-toggle}
if [[ $ACTION == "toggle" ]]; then
  if quattro-dwl-toggle-enabled internal-monitor-disable; then
    ACTION="on"
  else
    ACTION="off"
  fi
fi

case $ACTION in
  on)
    wlopm --on "$INTERNAL" >/dev/null 2>&1 || true
    quattro-dwl-toggle internal-monitor-disable off
    ;;
  off)
    wlopm --off "$INTERNAL" >/dev/null 2>&1 || true
    quattro-dwl-toggle internal-monitor-disable on
    ;;
  *)
    echo "Usage: quattro-dwl-monitor-internal [on|off|toggle]" >&2
    exit 1
    ;;
esac
