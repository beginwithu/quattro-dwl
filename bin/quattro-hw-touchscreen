#!/bin/bash

# quattro:summary=Print the detected touchscreen or tablet device name

input_class="${QUATTRO_INPUT_CLASS_PATH:-/sys/class/input}"
for event in "$input_class"/event*; do
  [[ -r $event/device/name ]] || continue
  if udevadm info --query=property "$event" 2>/dev/null | grep -Eqx 'ID_INPUT_TOUCHSCREEN=1|ID_INPUT_TABLET=1'; then
    <"$event/device/name" cat
    exit 0
  fi
done
