#!/bin/bash

# quattro:summary=Enable, disable, or toggle an input device state flag
# quattro:args=<touchpad|touchscreen> [on|off|toggle]
# quattro:hidden=true

set -euo pipefail

KIND="${1:-}"
ACTION="${2:-toggle}"

usage() {
  echo "Usage: quattro-toggle-input-device <touchpad|touchscreen> [on|off|toggle]" >&2
}

case "$KIND" in
  touchpad) ICON="touchpad" ;;
  touchscreen) ICON="touch" ;;
  *)
    usage
    exit 1
    ;;
esac

NAME_FILE="$HOME/.local/state/quattro/toggles/dwl/$KIND-disabled-name"
device="$("quattro-hw-$KIND")"

enable() {
  rm -f "$NAME_FILE"
  if [[ $KIND == "touchpad" ]]; then
    quattro-osd -i "$ICON" -m "$(quattro-i18n input.touchpadEnabled)"
  else
    quattro-osd -i "$ICON" -m "$(quattro-i18n input.touchscreenEnabled)"
  fi
}

disable() {
  [[ -n $device ]] || { echo "No $KIND device found" >&2; exit 1; }
  mkdir -p "$(dirname "$NAME_FILE")"
  printf '%s\n' "$device" >"$NAME_FILE"
  if [[ $KIND == "touchpad" ]]; then
    quattro-osd -i "$ICON" -m "$(quattro-i18n input.touchpadDisabled)"
  else
    quattro-osd -i "$ICON" -m "$(quattro-i18n input.touchscreenDisabled)"
  fi
}

case "$ACTION" in
  on) enable ;;
  off) disable ;;
  toggle) if [[ -f $NAME_FILE ]]; then enable; else disable; fi ;;
  *)
    usage
    exit 1
    ;;
esac
