#!/bin/bash

# quattro:summary=Print monitor panel state for the shell
# quattro:group=monitor

set -u

randr_raw=$(quattro-dwl-ipc --monitors 2>/dev/null || echo '[]')
focused_monitor=""
if command -v quattro-dwl-ipc >/dev/null 2>&1; then
  focused_monitor=$(quattro-dwl-ipc --once 2>/dev/null | jq -r '.focusedOutput // ""' 2>/dev/null || true)
fi

monitors_json=$(printf '%s\n' "$randr_raw" | jq --arg focused "$focused_monitor" '
  def t_num:
    if . == "90" then 1
    elif . == "180" then 2
    elif . == "270" then 3
    elif . == "flipped" then 4
    elif . == "flipped-90" then 5
    elif . == "flipped-180" then 6
    elif . == "flipped-270" then 7
    else 0 end;
  [.[] |
    ((.modes // []) | map(select(.current == true))[0] // (.modes // [])[0] // {width: 0, height: 0, refresh: 0}) as $cur |
    {
      name: (.name // ""),
      make: (.make // ""),
      model: (.model // ""),
      enabled: (.enabled != false),
      focused: ((.name // "") == $focused),
      width: ($cur.width // 0),
      height: ($cur.height // 0),
      physicalWidth: (.physical_size.width // 0),
      physicalHeight: (.physical_size.height // 0),
      refreshRate: ($cur.refresh // 0),
      scale: (.scale // 1),
      x: (.position.x // 0),
      y: (.position.y // 0),
      transform: ((.transform // "normal") | t_num),
      mirrorOf: "none",
      availableModes: [(.modes // [])[] | "\(.width)x\(.height)@\(((.refresh // 60) * 100 | round) / 100)Hz"]
    }
  ]
')

if [[ -z $focused_monitor ]]; then
  focused_monitor=$(printf '%s\n' "$monitors_json" | jq -r '[.[] | select(.enabled == true)][0].name // ""')
  monitors_json=$(printf '%s\n' "$monitors_json" | jq --arg focused "$focused_monitor" '[.[] | .focused = (.name == $focused)]')
fi

brightness_dir=$(mktemp -d)
trap 'rm -rf "$brightness_dir"' EXIT
while read -r name; do
  [[ $name =~ ^[A-Za-z0-9._-]+$ ]] || continue
  { quattro-brightness-display --monitor "$name" 2>/dev/null; echo; } | head -n 1 >"$brightness_dir/$name" &
done < <(printf '%s\n' "$monitors_json" | jq -r '.[] | select(.enabled == true) | .name')
wait

if [[ -n $focused_monitor && -f $brightness_dir/$focused_monitor ]]; then
  cat "$brightness_dir/$focused_monitor"
else
  echo
fi

printf '%s\n' "$monitors_json" | jq -r '
  def internal: test("^(eDP|LVDS|DSI)-");
  ([.[] | select(.name | internal)][0].name // ""),
  ([.[] | select((.name | internal) | not)][0].name // ""),
  ([.[] | select((.name | internal) and .enabled == true)][0].name // ""),
  ""
'

printf '%s\n' "$focused_monitor"
quattro-dwl-monitor-scaling 2>/dev/null || echo

brightness_json=$(for file in "$brightness_dir"/*; do
  [[ -f $file ]] && printf '%s\t%s\n' "${file##*/}" "$(<"$file")"
done | jq -R -n '[inputs | split("\t") | select(.[1] | test("^[0-9]+$")) | {(.[0]): (.[1] | tonumber)}] | add // {}')

printf '%s\n' "$monitors_json" | jq -c --argjson brightness "$brightness_json" \
  '[.[] | . + {brightness: ($brightness[.name] // null)}]'

if quattro-dwl-toggle-enabled internal-monitor-mirror; then
  echo on
else
  echo
fi
