#!/bin/bash

# quattro:summary=Launch an app or focus an existing window matching a pattern
# quattro:args=<window-pattern> <launch-command>

if (($# == 0)); then
  echo "Usage: quattro-launch-or-focus [window-pattern] [launch-command]"
  exit 1
fi

WINDOW_PATTERN="$1"
LAUNCH_COMMAND="${2:-"uwsm-app -- $WINDOW_PATTERN"}"
eval exec setsid "$LAUNCH_COMMAND"
